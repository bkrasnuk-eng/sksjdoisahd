use std::env;
use std::fs::{self, File, OpenOptions};
use std::io::{self, Read, Seek, SeekFrom, Write};
use std::path::Path;
use std::thread;
use std::time::Instant;

/// Копіює один логічний діапазон байтів з вихідного файлу в цільовий.
/// Кожен потік працює зі своїм неперекриваючим діапазоном — синхронізація не потрібна.
fn copy_chunk(
    src_path: &str,
    dst_path: &str,
    start: u64,
    size: u64,
    _thread_id: usize,
) -> io::Result<()> {
    let mut src = File::open(src_path)?;
    let mut dst = OpenOptions::new()
        .read(true)
        .write(true)
        .open(dst_path)?;

    src.seek(SeekFrom::Start(start))?;
    dst.seek(SeekFrom::Start(start))?;

    const BUFFER_SIZE: usize = 1024 * 1024; // 1 МБ
    let mut buffer = vec![0u8; BUFFER_SIZE];
    let mut remaining = size;

    while remaining > 0 {
        let to_read = std::cmp::min(BUFFER_SIZE as u64, remaining) as usize;
        let n = src.read(&mut buffer[..to_read])?;
        if n == 0 {
            break;
        }
        dst.write_all(&buffer[..n])?;
        remaining -= n as u64;
    }

    Ok(())
}

/// Організовує конкурентне копіювання файлу заданою кількістю потоків.
fn concurrent_copy(src: &str, dst: &str, num_threads: usize) -> io::Result<()> {
    let metadata = fs::metadata(src)?;
    if !metadata.is_file() {
        return Err(io::Error::new(
            io::ErrorKind::InvalidInput,
            "Вказаний шлях не є звичайним файлом",
        ));
    }

    let file_size = metadata.len();

    // Порожній файл
    if file_size == 0 {
        File::create(dst)?;
        println!("Порожній файл успішно створено.");
        return Ok(());
    }

    // Попереднє резервування місця під цільовий файл
    {
        let f = File::create(dst)?;
        f.set_len(file_size)?;
    }

    let chunk_size = file_size / num_threads as u64;
    let mut handles = Vec::with_capacity(num_threads);

    let start_time = Instant::now();

    for i in 0..num_threads {
        let start = i as u64 * chunk_size;
        let size = if i == num_threads - 1 {
            file_size - start
        } else {
            chunk_size
        };

        let src_owned = src.to_string();
        let dst_owned = dst.to_string();

        handles.push(thread::spawn(move || {
            if let Err(e) = copy_chunk(&src_owned, &dst_owned, start, size, i + 1) {
                eprintln!("Помилка в потоці {}: {}", i + 1, e);
            }
        }));
    }

    for handle in handles {
        handle.join().expect("Помилка очікування потоку");
    }

    let elapsed = start_time.elapsed();
    println!(
        "Копіювання завершено. Час виконання: {:.3} с",
        elapsed.as_secs_f64()
    );

    Ok(())
}

fn print_usage(program: &str) {
    eprintln!(
        "Використання: {} <вихідний_файл> <цільовий_файл> [кількість_потоків]",
        program
    );
    eprintln!("Якщо кількість потоків не вказана, використовується 4.");
}

fn main() {
    let args: Vec<String> = env::args().collect();

    if args.len() < 3 || args.len() > 4 {
        print_usage(&args[0]);
        std::process::exit(1);
    }

    let src = &args[1];
    let dst = &args[2];

    let num_threads = if args.len() == 4 {
        match args[3].parse::<usize>() {
            Ok(n) if n > 0 => n,
            _ => {
                eprintln!("Кількість потоків має бути додатним цілим числом.");
                std::process::exit(1);
            }
        }
    } else {
        4
    };

    if !Path::new(src).exists() {
        eprintln!("Помилка: вихідний файл '{}' не існує.", src);
        std::process::exit(1);
    }

    if let Err(e) = concurrent_copy(src, dst, num_threads) {
        eprintln!("Помилка копіювання: {}", e);
        std::process::exit(1);
    }
}
